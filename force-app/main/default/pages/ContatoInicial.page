<apex:page controller="ContatoInicialController" showHeader="false" sidebar="false" standardStylesheets="false" applyHtmlTag="false" applyBodyTag="false" docType="html-5.0" cache="false">
<html lang="pt-BR">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>GTech | Contato inicial</title>
    <style>
        :root {
            --petroleo: #003c4d;
            --azul: #385da9;
            --gelo: #dce5f5;
            --texto: #1f2d3d;
            --erro: #b42318;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: var(--texto);
            background: #f4f6fb;
        }
        .topo { background: var(--petroleo); padding: 16px 24px; }
        .topo img { height: 40px; display: block; }
        .cartao {
            max-width: 640px;
            margin: 32px auto;
            padding: 32px;
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 4px 24px rgba(0, 60, 77, 0.08);
        }
        h1 { margin: 0 0 8px; font-size: 24px; color: var(--petroleo); }
        p { line-height: 1.5; }
        .sub { margin: 0 0 24px; color: #52606d; }
        .grade { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .campo { display: flex; flex-direction: column; }
        .campo.cheio { grid-column: 1 / -1; }
        label { font-size: 13px; font-weight: 600; margin-bottom: 6px; }
        input[type=text], select {
            padding: 11px 12px;
            font-size: 15px;
            border: 1px solid #c4cdd8;
            border-radius: 8px;
            background: #fff;
        }
        input[type=text]:focus, select:focus { outline: 2px solid var(--azul); border-color: var(--azul); }
        .consent { display: flex; gap: 10px; align-items: flex-start; font-size: 13px; color: #3e4c59; margin-top: 8px; }
        .consent input { margin-top: 3px; }
        .botao {
            margin-top: 24px;
            width: 100%;
            padding: 14px;
            font-size: 16px;
            font-weight: 600;
            color: #fff;
            background: var(--azul);
            border: 0;
            border-radius: 10px;
            cursor: pointer;
        }
        .botao:hover { background: var(--petroleo); }
        .erros { margin: 0 0 20px; padding: 12px 16px; background: #fef3f2; border-left: 4px solid var(--erro); border-radius: 6px; color: var(--erro); font-size: 14px; }
        .erros ul { margin: 0; padding-left: 18px; }
        .estado { text-align: center; padding: 16px 0; }
        .estado .selo { width: 56px; height: 56px; border-radius: 50%; background: var(--gelo); color: var(--azul); font-size: 30px; line-height: 56px; margin: 0 auto 16px; }
        @media (max-width: 560px) {
            .cartao { margin: 0; border-radius: 0; box-shadow: none; padding: 24px 16px; }
            .grade { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <header class="topo">
        <img src="{!URLFOR($Resource.GTech_Logo_Site)}" alt="GTech"/>
    </header>

    <main class="cartao">
        <apex:outputPanel layout="none" rendered="{!estado == 'form'}">
            <h1>Olá, {!nomeContato}!</h1>
            <p class="sub">Para continuarmos a conversa com a {!empresa}, confirme os dados da empresa abaixo. Leva menos de um minuto.</p>

            <apex:form>
                <apex:outputPanel layout="none" rendered="{!temErros}">
                    <div class="erros">
                        <apex:messages/>
                    </div>
                </apex:outputPanel>

                <div class="grade">
                    <div class="campo">
                        <apex:outputLabel value="CNPJ" for="cnpj"/>
                        <apex:inputText id="cnpj" value="{!cnpj}" html-inputmode="numeric" html-placeholder="00.000.000/0000-00" maxlength="18"/>
                    </div>
                    <div class="campo">
                        <apex:outputLabel value="Porte da empresa" for="porte"/>
                        <apex:selectList id="porte" value="{!porte}" size="1">
                            <apex:selectOptions value="{!portes}"/>
                        </apex:selectList>
                    </div>
                    <div class="campo cheio">
                        <apex:outputLabel value="Produto ou serviço de interesse" for="produto"/>
                        <apex:selectList id="produto" value="{!produto}" size="1">
                            <apex:selectOptions value="{!produtos}"/>
                        </apex:selectList>
                    </div>
                    <div class="campo">
                        <apex:outputLabel value="Telefone" for="telefone"/>
                        <apex:inputText id="telefone" value="{!telefone}" html-inputmode="tel" maxlength="40"/>
                    </div>
                    <div class="campo">
                        <apex:outputLabel value="WhatsApp" for="whatsapp"/>
                        <apex:inputText id="whatsapp" value="{!whatsapp}" html-inputmode="tel" maxlength="40"/>
                    </div>
                    <div class="campo cheio">
                        <apex:outputLabel value="Seu cargo" for="cargo"/>
                        <apex:inputText id="cargo" value="{!cargo}" maxlength="128"/>
                    </div>
                </div>

                <div class="consent">
                    <apex:inputCheckbox id="consent" value="{!consentimento}"/>
                    <apex:outputLabel for="consent" style="font-weight: normal; margin: 0;">
                        Autorizo a GTech a usar estes dados para contato comercial, conforme a LGPD (Lei 13.709/2018). Posso pedir a exclusão a qualquer momento.
                    </apex:outputLabel>
                </div>

                <apex:commandButton action="{!enviar}" value="Enviar dados" styleClass="botao"/>
            </apex:form>
        </apex:outputPanel>

        <apex:outputPanel layout="none" rendered="{!estado == 'sucesso'}">
            <div class="estado">
                <div class="selo">&#10003;</div>
                <h1>Recebemos seus dados</h1>
                <p>Obrigado, {!nomeContato}. Nosso time vai continuar o atendimento em breve.</p>
            </div>
        </apex:outputPanel>

        <apex:outputPanel layout="none" rendered="{!estado == 'invalido'}">
            <div class="estado">
                <h1>Este link não está mais disponível</h1>
                <p>Ele pode ter expirado ou já ter sido usado. Peça um novo link ao seu contato na GTech.</p>
            </div>
        </apex:outputPanel>
    </main>

    <script>
        (function () {
            var campo = document.querySelector('input[id$=":cnpj"]');
            if (!campo) { return; }
            campo.addEventListener('input', function () {
                var d = campo.value.replace(/\D/g, '').slice(0, 14);
                var m = d;
                if (d.length > 12) { m = d.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{0,2}).*/, '$1.$2.$3/$4-$5'); }
                else if (d.length > 8) { m = d.replace(/^(\d{2})(\d{3})(\d{3})(\d{0,4}).*/, '$1.$2.$3/$4'); }
                else if (d.length > 5) { m = d.replace(/^(\d{2})(\d{3})(\d{0,3}).*/, '$1.$2.$3'); }
                else if (d.length > 2) { m = d.replace(/^(\d{2})(\d{0,3}).*/, '$1.$2'); }
                campo.value = m;
            });
        })();
    </script>
</body>
</html>
</apex:page>
