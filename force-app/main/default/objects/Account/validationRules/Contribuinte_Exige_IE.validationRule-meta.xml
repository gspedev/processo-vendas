<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Contribuinte_Exige_IE</fullName>
    <active>true</active>
    <errorConditionFormula>AND(TEXT(Contribuinte_ICMS__c) = &quot;Contribuinte&quot;, ISBLANK(Inscricao_Estadual__c))</errorConditionFormula>
    <errorDisplayField>Inscricao_Estadual__c</errorDisplayField>
    <errorMessage>Informe a inscrição estadual de uma conta contribuinte do ICMS.</errorMessage>
</ValidationRule>
