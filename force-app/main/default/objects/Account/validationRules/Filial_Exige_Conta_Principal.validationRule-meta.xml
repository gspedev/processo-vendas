<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Filial_Exige_Conta_Principal</fullName>
    <active>true</active>
    <errorConditionFormula>AND(TEXT(Tipo_Estabelecimento__c) = &quot;Filial&quot;, ISBLANK(ParentId))</errorConditionFormula>
    <errorDisplayField>ParentId</errorDisplayField>
    <errorMessage>Informe a conta da matriz para cadastrar uma filial.</errorMessage>
</ValidationRule>
