<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CPF_Invalido</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(CPF__c)), NOT(REGEX(CPF__c, "\\d{11}")))</errorConditionFormula>
    <errorDisplayField>CPF__c</errorDisplayField>
    <errorMessage>O CPF deve ter 11 dígitos, somente números.</errorMessage>
</ValidationRule>
