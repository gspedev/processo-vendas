<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Produto_Interesse_Obrigatorio</fullName>
    <active>true</active>
    <errorConditionFormula>AND(OR(TEXT(Status)=&quot;Qualified&quot;, TEXT(Status)=&quot;Closed - Converted&quot;), ISBLANK(Produto_Interesse__c))</errorConditionFormula>
    <errorDisplayField>Produto_Interesse__c</errorDisplayField>
    <errorMessage>Informe o produto de interesse para qualificar o lead.</errorMessage>
</ValidationRule>
