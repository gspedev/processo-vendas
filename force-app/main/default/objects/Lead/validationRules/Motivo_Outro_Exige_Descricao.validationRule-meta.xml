<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Motivo_Outro_Exige_Descricao</fullName>
    <active>true</active>
    <errorConditionFormula>AND(TEXT(Motivo_Nao_Conversao__c)=&quot;Outro&quot;, ISBLANK(Description))</errorConditionFormula>
    <errorDisplayField>Description</errorDisplayField>
    <errorMessage>Descreva o motivo na descrição do lead.</errorMessage>
</ValidationRule>
