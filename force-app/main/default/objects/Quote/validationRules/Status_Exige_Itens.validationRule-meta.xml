<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status_Exige_Itens</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISCHANGED(Status), LineItemCount = 0, NOT(ISPICKVAL(Status, &quot;Rascunho&quot;)), NOT(ISPICKVAL(Status, &quot;Cancelada&quot;)))</errorConditionFormula>
    <errorDisplayField>Status</errorDisplayField>
    <errorMessage>Adicione pelo menos um item antes de avançar a cotação.</errorMessage>
</ValidationRule>
